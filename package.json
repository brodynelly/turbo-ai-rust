{
  "name": "turbo-ai",
  "version": "1.0.2-beta",
  "description": "Turbo Pascal 7 inspired desktop app frontend for the Pi coding agent (RPC mode)",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri dev",
    "tauri:build": "tauri build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "electron": "^45.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
