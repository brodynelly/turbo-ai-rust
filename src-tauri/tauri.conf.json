{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "TURBO-AI",
	"version": "1.0.2",
	"identifier": "com.brodynelly.turbo-ai",
	"build": {
		"frontendDist": "../renderer"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "TURBO-AI 1.0.2 Beta",
				"width": 1180,
				"height": 780,
				"minWidth": 760,
				"minHeight": 480,
				"center": true,
				"decorations": false
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": ["icons/icon.ico"]
	}
}
